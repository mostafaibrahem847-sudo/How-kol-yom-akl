# Copy to .env and fill in with your Supabase project values.
# Expo inlines EXPO_PUBLIC_* variables into the client bundle at build time,
# so only the public anon/publishable key belongs here — never the service role.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Clerk publishable key. Publishable keys are public by design and safe to ship
# in the client bundle; never place the Clerk secret key here. The ClerkProvider
# reads this automatically via EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Server-side only. Used by scripts (e.g. scripts/test-elevenlabs.ts) to call
# the ElevenLabs API. NEVER rename this to EXPO_PUBLIC_* and never import it
# into client/React Native code.
ELEVENLABS_API_KEY=
